# Locked folder (Skryté): wrapped key + sealed thumbnails, never versioned
vault/

# Gate 0: po migraci do AppData zůstává ve složce aplikace jen záloha + poznámka
KAIROS_DATA_MOVED.txt
portable.txt

# Instalátor (Inno Setup) – výstup
installer/Output/

# iOS (ios/): SwiftPM / Xcode artefacts – the project is generated from project.yml
ios/.build/
ios/.swiftpm/
ios/*.xcodeproj/
ios/DerivedData/
ios/KairosApp/Info.plist
